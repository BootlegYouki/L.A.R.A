{
  "$schema": "https://json.schemastore.org/design-tokens.json",
  "name": "L.A.R.A. Design Tokens",
  "version": "2.0.0",
  "description": "Design tokens for the L.A.R.A. offline classroom apps (Android, Desktop, Hub). Mirrors docs/design-system-showcase.html. Zero gradients, Nunito, Phosphor.",
  "color": {
    "brand": {
      "primary": {
        "value": "#2E9B4B",
        "compose": "LaraColors.Primary",
        "tailwind": "lara-primary",
        "comment": "Primary actions, active tabs, progress fill"
      },
      "primaryDark": {
        "value": "#176B36",
        "compose": "LaraColors.PrimaryDark",
        "tailwind": "lara-primary-dark",
        "comment": "Hover and pressed, app bar, class card header"
      },
      "primaryLight": {
        "value": "#E4F6E8",
        "compose": "LaraColors.PrimaryLight",
        "tailwind": "lara-primary-light",
        "comment": "Selected states, success fills, tag backgrounds"
      },
      "ai": {
        "value": "#5145E5",
        "compose": "LaraColors.Ai",
        "tailwind": "lara-ai",
        "comment": "Socratic AI tutor surfaces ONLY"
      },
      "aiDark": {
        "value": "#4035C9",
        "compose": "LaraColors.AiDark",
        "tailwind": "lara-ai-dark",
        "comment": "AI pressed state, AI text on light purple"
      },
      "aiLight": {
        "value": "#EEEAFE",
        "compose": "LaraColors.AiLight",
        "tailwind": "lara-ai-light",
        "comment": "Tutor chat bubble surface"
      },
      "aiBorder": {
        "value": "#D6CCFC",
        "compose": "LaraColors.AiBorder",
        "tailwind": "lara-ai-border",
        "comment": "AI surface borders"
      },
      "aiBubbleText": {
        "value": "#2D237A",
        "compose": "LaraColors.AiBubbleText",
        "tailwind": "lara-ai-bubble-text",
        "comment": "Text on the tutor bubble"
      },
      "aiChatBackground": {
        "value": "#FAF9FE",
        "compose": "LaraColors.AiChatBackground",
        "tailwind": "lara-ai-chat-bg",
        "comment": "Tutor chat panel background"
      }
    },
    "surface": {
      "canvas": {
        "value": "#F7FBFA",
        "compose": "LaraColors.Canvas",
        "tailwind": "lara-canvas",
        "comment": "Screen and window background"
      },
      "white": {
        "value": "#FFFFFF",
        "compose": "LaraColors.Surface",
        "tailwind": "white",
        "comment": "Cards, dialogs, sheets, inputs"
      },
      "subtle": {
        "value": "#F2F6F5",
        "compose": "LaraColors.SurfaceSubtle",
        "tailwind": "lara-subtle",
        "comment": "Table headers, segmented control track, disabled fields"
      },
      "border": {
        "value": "#E4EAF0",
        "compose": "LaraColors.Border",
        "tailwind": "lara-border",
        "comment": "Card and input outlines, dividers, progress track"
      }
    },
    "text": {
      "primary": {
        "value": "#17213D",
        "compose": "LaraColors.TextPrimary",
        "tailwind": "lara-ink",
        "comment": "Headings, questions, body"
      },
      "secondary": {
        "value": "#667085",
        "compose": "LaraColors.TextSecondary",
        "tailwind": "lara-ink-2",
        "comment": "Metadata, timestamps, captions"
      },
      "muted": {
        "value": "#98A2B3",
        "compose": "LaraColors.TextMuted",
        "tailwind": "lara-ink-3",
        "comment": "Placeholders and disabled content only"
      }
    },
    "status": {
      "success": {
        "value": "#22A447",
        "border": "#C4ECCB",
        "light": "#E4F6E8",
        "text": "#176B36",
        "comment": "SYNCED, passed, correct"
      },
      "warning": {
        "value": "#F5B82E",
        "light": "#FEF0C7",
        "text": "#B54708",
        "border": "#FEDF89",
        "comment": "QUEUED_FOR_SYNC, due soon, timer under 5 minutes"
      },
      "danger": {
        "value": "#EF5350",
        "light": "#FEE4E2",
        "text": "#B42318",
        "border": "#FECDCA",
        "comment": "Errors, lockout, timer under 1 minute"
      },
      "info": {
        "value": "#3B82F6",
        "light": "#E0F2FE",
        "text": "#0369A1",
        "border": "#BAE6FD",
        "comment": "DepEd categories, neutral information"
      }
    }
  },
  "typography": {
    "fontFamily": "Nunito, system-ui, sans-serif",
    "minimumBodyOnMobile": "16sp",
    "scale": {
      "display": {
        "fontSize": "40px",
        "lineHeight": "48px",
        "fontWeight": "900",
        "compose": "displayLarge"
      },
      "heading1": {
        "fontSize": "28px",
        "lineHeight": "36px",
        "fontWeight": "800",
        "compose": "headlineLarge"
      },
      "heading2": {
        "fontSize": "22px",
        "lineHeight": "30px",
        "fontWeight": "700",
        "compose": "headlineMedium"
      },
      "title": {
        "fontSize": "18px",
        "lineHeight": "26px",
        "fontWeight": "800",
        "compose": "titleMedium"
      },
      "body": {
        "fontSize": "16px",
        "lineHeight": "24px",
        "fontWeight": "500",
        "compose": "bodyLarge"
      },
      "label": {
        "fontSize": "14px",
        "lineHeight": "20px",
        "fontWeight": "800",
        "compose": "labelLarge"
      },
      "caption": {
        "fontSize": "12px",
        "lineHeight": "16px",
        "fontWeight": "600",
        "compose": "bodySmall"
      }
    }
  },
  "spacing": {
    "touchTargetMin": "52px",
    "touchTargetPrimary": "56px",
    "grid": {
      "1": "4px",
      "2": "8px",
      "3": "12px",
      "4": "16px",
      "5": "20px",
      "6": "24px",
      "8": "32px",
      "12": "48px"
    }
  },
  "radius": {
    "sm": "8px",
    "md": "12px",
    "lg": "16px",
    "xl": "24px",
    "pill": "9999px"
  },
  "shadow": {
    "card": "0 1px 3px 0 rgba(23, 33, 61, 0.05), 0 1px 2px -1px rgba(23, 33, 61, 0.05)",
    "cardHover": "0 4px 6px -1px rgba(23, 33, 61, 0.07), 0 2px 4px -2px rgba(23, 33, 61, 0.05)",
    "elevated": "0 10px 15px -3px rgba(23, 33, 61, 0.08), 0 4px 6px -4px rgba(23, 33, 61, 0.04)",
    "toast": "0 12px 28px -4px rgba(23, 33, 61, 0.12), 0 4px 8px -2px rgba(23, 33, 61, 0.06)",
    "modal": "0 24px 48px -12px rgba(23, 33, 61, 0.22), 0 8px 16px -4px rgba(23, 33, 61, 0.08)"
  }
}
