{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "QuizSubmitEvent",
  "type": "object",
  "required": ["event", "quiz_id", "student_id", "answers", "submitted_at"],
  "properties": {
    "event": { "type": "string", "const": "EVENT_QUIZ_SUBMIT" },
    "quiz_id": { "type": "string" },
    "student_id": { "type": "string" },
    "submitted_at": { "type": "integer" },
    "answers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["question_id", "selected_option"],
        "properties": {
          "question_id": { "type": "string" },
          "selected_option": { "type": "string" }
        }
      }
    }
  }
}