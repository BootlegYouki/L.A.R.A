{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ErrorEvent",
  "description": "Hub to client: a WebSocket request was rejected. There are no tutor errors: the tutor runs on the device and never reaches the Hub.",
  "type": "object",
  "required": [
    "event",
    "code",
    "message"
  ],
  "properties": {
    "event": {
      "type": "string",
      "const": "EVENT_ERROR"
    },
    "code": {
      "type": "string",
      "enum": [
        "UNAUTHORIZED",
        "FORBIDDEN",
        "BAD_REQUEST"
      ]
    },
    "message": {
      "type": "string"
    },
    "request_id": {
      "type": "string"
    }
  }
}
