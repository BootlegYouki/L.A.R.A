<?xml version="1.0" encoding="utf-8"?>
<!--
  XML-side color values used only by the launch theme and system bars. The canonical, single
  source of color tokens for the UI is ui/theme/Color.kt (LaraColors); these two values mirror
  Primary Green and Dark Green so the launch window matches the brand before Compose draws.
-->
<resources>
    <color name="lara_primary">#2E9B4B</color>
    <color name="lara_primary_dark">#176B36</color>
    <color name="lara_canvas">#F7FBFA</color>
    <color name="white">#FFFFFF</color>
</resources>
