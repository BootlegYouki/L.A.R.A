<?xml version="1.0" encoding="utf-8"?>
<!--
  Legacy auto-backup rules (API 26..30). The app is offline-first and holds no cloud account, so
  nothing is backed up off-device here; this file exists to satisfy the manifest reference.
  See https://developer.android.com/guide/topics/data/autobackup
-->
<full-backup-content>
    <exclude domain="sharedpref" path="." />
    <exclude domain="database" path="." />
</full-backup-content>
