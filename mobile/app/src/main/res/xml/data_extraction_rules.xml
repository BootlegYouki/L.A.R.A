<?xml version="1.0" encoding="utf-8"?>
<!--
  Data-extraction rules (API 31+). The app keeps no cloud sync and stores a bearer token in
  encrypted storage, so cloud backup and device-transfer are disabled to avoid leaking local
  credentials. See https://developer.android.com/guide/topics/data/autobackup
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
        <!-- Homework photos (minors' personal data) live in the app files dir; keep them on-device. -->
        <exclude domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
        <exclude domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
