# Copy to config.env to change a setting. A variable that is already set in the environment wins over this file.
# LLM_BACKEND=vulkan        # vulkan (offload everything to the GPU) or cpu
# LLM_NGL=99                # layers on the GPU; 0 = CPU only
# LLM_THREADS=4             # CPU threads for the LLM (12 is the CPU-only default)
# LLM_SLOTS=5               # parallel chats; context is 2048 per slot (GPU default 5, CPU default 1)
# LLM_MODEL=Qwen3-4B-Instruct-2507-Q4_K_M.gguf   # file name in models/llm, or a full path
# EMBED_THREADS=2
# EMBED_NGL=0               # 99 = embed on the GPU (faster first ingest of a long PDF)
# MAX_CHUNKS=3              # lesson chunks sent per question
# DEFAULT_RETRIEVER=hybrid  # hybrid | bm25 | vector | keyword
# DEFAULT_RERANK=on         # off | on | compress
# DEFAULT_PROMPT=V5         # V1 (contract) .. V5, V0 = plain QA
# DEFAULT_THRESHOLD=0.65    # cosine part of the not-covered guard (the bm25 part is in calibration.json)
# APP_PORT=8000
# LLM_PORT=8090
# EMBED_PORT=8091
# LLAMA_SERVER=C:\path\to\llama-server.exe
# MODELS_DIR=D:\models\llm
# MODELS_EXTRA_DIRS=D:\more-models;E:\even-more   # folders added to the page's model dropdown
# POPPLER_BIN=C:\path\to\poppler\Library\bin
