          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="local-boundary" value="&lt;div style=&quot;white-space:normal;line-height:1.25;&quot;&gt;Client boundary rules (not Hub stores or processes):&lt;br&gt;1. Local work remains QUEUED_FOR_SYNC until an acknowledgement receipt.&lt;br&gt;2. Apply the complete pull page AND next_cursor in one local transaction; roll back both on failure.&lt;br&gt;3. On reset, rebuild the mirror while keeping queued work; continue pulling while has_more is true.&lt;br&gt;4. seq is the cursor; server_time is only for clock offset. There is no sync_status column in the master schema.&lt;br&gt;D6 Tutor History is not in the current SyncPullResponse. Adjacent domain processes are dashed.&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;fontColor=#000000;fontFamily=Arial;fontSize=17;fontSize=17;fontStyle=0;" vertex="1" parent="1" kind="note">
