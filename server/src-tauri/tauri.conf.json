{
  "productName": "L.A.R.A Hub",
  "version": "0.1.0",
  "identifier": "org.lara.hub",
  "build": {
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "L.A.R.A Hub",
        "width": 960,
        "height": 640,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; font-src 'self'; img-src 'self'",
      "devCsp": "default-src 'self' 'unsafe-inline' http://localhost:5173 ws://localhost:5173"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb", "appimage"],
    "category": "Education",
    "shortDescription": "L.A.R.A classroom Hub",
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "offlineInstaller", "silent": true },
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "./windows/hooks.nsh"
      }
    },
    "linux": {
      "deb": {
        "postInstallScript": "./linux/postinst.sh",
        "desktopTemplate": "./linux/lara-hub.desktop"
      }
    }
  }
}
