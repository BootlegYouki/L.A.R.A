{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop-local-database",
  "description": "Local database and discovery event subscriptions for the main desktop window only.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "sql:allow-load",
    "sql:allow-select",
    "sql:allow-execute"
  ]
}
